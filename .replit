modules = ["python-base-3.13"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "BlackBullRadar"

[[workflows.workflow]]
name = "BlackBullRadar"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ".venv/bin/python main.py"

[deployment]
deploymentTarget = "vm"
run = [".venv/bin/python", "main.py"]
build = ["bash", "-c", "uv venv --clear .venv && uv pip install --python .venv 'python-telegram-bot[job-queue]' requests"]
